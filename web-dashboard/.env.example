# =============================================================================
# EVMOTO DASHBOARD AUTOMATION - ENVIRONMENT CONFIGURATION
# =============================================================================
# Salin file ini menjadi '.env' di folder Automation_Project_EvMoto/
# Cukup ganti baris ENVIRONMENT=dev atau ENVIRONMENT=production untuk beralih target!
# =============================================================================

# 1. PILIH ENVIRONMENT AKTIF (dev | production | staging | local)
ENVIRONMENT=production

# 2. KONFIGURASI ENVIRONMENT PRODUCTION (LIVE)
PROD_BASE_URL=https://dashboard.evmotoid.com
PROD_USER=<PROD_USER>
PROD_PASS=<PROD_PASS>

# 3. KONFIGURASI ENVIRONMENT DEV (STAGING / DEVELOPMENT)
DEV_BASE_URL=https://dev-dashboard.evmotoid.com
DEV_USER=dev_qa
DEV_PASS=DevSecret123

# 4. (OPSIONAL) OVERRIDE LANGSUNG (Memiliki prioritas tertinggi jika diaktifkan)
# BASE_URL=https://staging-dashboard.evmotoid.com
# VALID_USER=custom_user
# VALID_PASS=custom_password

# 5. PENGATURAN BROWSER & EKSEKUSI
HEADLESS=true
PLATFORM=Website (Desktop)

# =============================================================================
# 6. EVMOTO BACKEND API ENDPOINTS (JAVA & GOLANG)
# =============================================================================
JAVA_DEV_API_URL=https://dev-api.evmotoid.com
JAVA_PROD_API_URL=https://api.evmotoid.com
GOLANG_DEV_API_IP=http://139.162.60.46
GOLANG_DEV_API_URL=https://evmotodev.justkidding.app
GOLANG_PROD_API_URL=https://new-api.evmotoid.com

# Active Backend Selection (java | golang) & default URL
BACKEND_TYPE=golang
BACKEND_API_URL=https://new-api.evmotoid.com

