# ==============================================================================
# EVMOTO USER MOBILE AUTOMATION - ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Salin file ini menjadi '.env' di folder evmoto-user-mobile-automation/
# Cukup ganti baris ENVIRONMENT=dev atau ENVIRONMENT=production untuk beralih target!
# ==============================================================================

# 1. PILIH ENVIRONMENT AKTIF (dev | production / prod)
ENVIRONMENT=dev

# 2. KONFIGURASI ENVIRONMENT DEV (STAGING / DEVELOPMENT)
DEV_EVMOTO_USER_APK=/path/ke/file.apk
DEV_EVMOTO_DRIVER_APK=/path/ke/file.apk
DEV_PHONE=<TEST_USER_PHONE>
DEV_OTP=<EVMOTO_OTP_BYPASS>

# 3. KONFIGURASI ENVIRONMENT PRODUCTION (LIVE / PROD DEBUG GOLANG)
PROD_EVMOTO_USER_APK=/path/ke/file.apk
PROD_EVMOTO_DRIVER_APK=/path/ke/file.apk
PROD_PHONE=<TEST_USER_PHONE>
PROD_OTP=<EVMOTO_OTP_BYPASS>

# 4. (OPSIONAL) OVERRIDE LANGSUNG (Memiliki prioritas tertinggi jika diisi)
# EVMOTO_USER_APK=/path/ke/file.apk
# EVMOTO_DRIVER_APK=/path/ke/file.apk
# ACTIVE_PHONE=
# ACTIVE_OTP=

# 5. APPIUM SERVER CONFIGURATION
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723

# 6. TARGET DEVICE (Samsung Galaxy S25 Emulator)
DEVICE_NAME=Samsung_Galaxy_S25
DEVICE_UDID=
AUTOMATION_NAME=UiAutomator2
PLATFORM_NAME=Android

# 7. PACING & TIMEOUTS
DEFAULT_TIMEOUT=25
HUMAN_PACING_SECONDS=3.0

# 8. LARK SUITE / FEISHU NOTIFIER WEBHOOK
LARK_WEBHOOK_URL=

# ==============================================================================
# 9. EVMOTO BACKEND API ENDPOINTS (JAVA & GOLANG)
# ==============================================================================
JAVA_DEV_API_URL=https://dev-api.evmotoid.com
JAVA_PROD_API_URL=https://api.evmotoid.com
GOLANG_DEV_API_IP=http://139.162.60.46
GOLANG_DEV_API_URL=https://evmotodev.justkidding.app
GOLANG_PROD_API_URL=https://new-api.evmotoid.com

# Active Backend Selection (java | golang) & active URL
BACKEND_TYPE=golang
BACKEND_API_URL=https://new-api.evmotoid.com

