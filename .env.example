# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE (SANITIZED / REKAYASA FOR REPOSITORY)
# Salin file ini menjadi .env di lokal Anda untuk mengisi kredensial aktif.
# File .env asli TIDAK PERNAH di-commit ke Git demi keamanan.
# ==============================================================================

# ----------------- BASE URL & ENDPOINTS (INTERNAL / STAGING) ------------------
EVMOTO_API_BASE_URL=https://api-dev.evmoto.internal
EVMOTO_ADMIN_PORTAL_URL=https://admin-staging.evmoto.internal
ECGO_API_BASE_URL=https://ecgo-api-dev.internal:3002
CONNECT_BRIDGE_URL=https://connect.evmoto.internal

# ----------------- CREDENTIALS SIMULATOR (DEV TEST ACCOUNTS) ------------------
# Akun Mitra Driver EvMoto
TEST_DRIVER_PHONE=0812XXXXXXXX
TEST_DRIVER_PIN=****

# Akun Mitra Driver ECGO SuperApps
TEST_ECGO_PHONE=0812XXXXXXXX
TEST_ECGO_OTP=******

# Akun Admin Web Dashboard
TEST_ADMIN_USERNAME=qa_admin_dev
TEST_ADMIN_PASSWORD=********

# ----------------- ENVIRONMENT FLAGS -----------------------------------------
TEST_ENVIRONMENT=staging
MOCK_API_FALLBACK=true
HEADLESS_MODE=true
